# Copy to backend/.env (not committed) or set in the environment.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
ASSISTANT_MAX_TOOL_ROUNDS=5
ASSISTANT_MEMORY_EXCHANGES=6
# Access control and cost limits (A-18)
ASSISTANT_ALLOW_GUESTS=true
ASSISTANT_PER_MINUTE=10
ASSISTANT_PER_DAY=100
ASSISTANT_DAILY_LLM_CALLS=3000
# Every Gemini call (assistant, summaries, translations, tags, embeddings), per Taiwan day
GEMINI_DAILY_CALLS=6000
