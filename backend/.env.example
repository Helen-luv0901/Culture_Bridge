# Copy to backend/.env (not committed) or set in the environment.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used in order when GEMINI_MODEL answers 429 (free quota used up for now); comma-separated
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
ASSISTANT_MAX_TOOL_ROUNDS=5
ASSISTANT_MEMORY_EXCHANGES=6
# Access control and cost limits (A-18)
ASSISTANT_ALLOW_GUESTS=true
# Sized for the Gemini free tier; raise them on a paid plan
ASSISTANT_PER_MINUTE=5
ASSISTANT_PER_DAY=20
ASSISTANT_DAILY_LLM_CALLS=700
# Every Gemini call (assistant, summaries, translations, tags, embeddings), per Taiwan day
GEMINI_DAILY_CALLS=2000
